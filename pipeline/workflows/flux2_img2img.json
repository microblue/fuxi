{
  "name": "Flux 2 Dev Image-to-Image",
  "description": "Flux 2 图生图 (I2I) 工作流 - 用于关键帧生成的顺序参考",
  "version": "1.0",
  "parameters": {
    "positive_prompt": "motion variation with energy...",
    "reference_image": "reference.png",
    "seed": 0,
    "width": 1344,
    "height": 768,
    "steps": 20,
    "cfg": 1.0,
    "sampler": "euler",
    "scheduler": "simple",
    "denoise": 0.5,
    "filename_prefix": "keyframe"
  },
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "flux2_dev_fp8mixed.safetensors",
        "weight_dtype": "fp8_e4m3fn"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "mistral_3_small_flux2_fp4_mixed.safetensors",
        "type": "flux2"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "flux2-vae.safetensors"
      }
    },
    "4": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "reference.png"
      }
    },
    "5": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "4",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "motion variation with energy...",
        "clip": [
          "2",
          0
        ]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "anatomy error, face distortion, extra limbs, watermark, text artifacts, oversharpen, uncanny look",
        "clip": [
          "2",
          0
        ]
      }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "positive": [
          "6",
          0
        ],
        "negative": [
          "7",
          0
        ],
        "latent_image": [
          "5",
          0
        ],
        "seed": 0,
        "steps": 20,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 0.5
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "8",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "10": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "9",
          0
        ],
        "filename_prefix": "keyframe"
      }
    }
  }
}
